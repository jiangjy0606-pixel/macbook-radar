{
  "name": "Module B2 Xianyu Browser PoC",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "runArgs": ["--init", "--shm-size=1g"],
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Module B2 noVNC",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "postCreateCommand": "bash module-b2-poc/setup.sh"
}
